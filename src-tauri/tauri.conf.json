{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glowline",
  "version": "0.2.0",
  "identifier": "app.halolyrics.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Glowline",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundColor": "#09090C"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app"
    ],
    "category": "Music",
    "shortDescription": "Full-screen lyrics for whatever is playing",
    "longDescription": "Glowline turns your screen into an ambient lyrics mode for whatever song is playing, using the operating system's media controls.",
    "copyright": "Copyright © 2026 HARSHAN-DEVHUB. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "publisher": "HARSHAN-DEVHUB",
    "homepage": "https://github.com/HARSHAN-DEVHUB/glowline-releases"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFODRCM0E1QjUwODM4MUUKUldRZU9BaTFwYk9FUGcwaU5ZR3AydnJEaGpvVno5cUVReEYxbXM0Q3dtT3Z1VmQzK09rK0JCTVAK",
      "endpoints": [
        "https://github.com/HARSHAN-DEVHUB/glowline-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
